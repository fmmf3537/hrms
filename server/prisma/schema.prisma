// M0-04: Prisma schema 骨架 | HRMS | 2026-08-23
// 一期基础表：User / Role / UserRole / Company / Department / Employee

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户表 ====================
model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  email        String?   @unique @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  status       String    @default("active") @db.VarChar(20) // active / disabled
  // 首次登录/默认口令用户必须改密：seed 的 admin 置 true，改密接口（M1）成功后清 false
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系：一个 User 对应一个 Employee
  employee Employee?

  // 关系：一个 User 拥有多个 Role（通过关联表）
  userRoles UserRole[]

  @@map("users")
}

// ==================== 角色表（RBAC） ====================
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50) // admin / hr / dept_head / executive / employee
  name        String   @db.VarChar(50) // 中文名
  description String?  @db.Text
  permissions Json     @default("[]") // 权限点数组
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系：一个 Role 被多个 User 拥有（通过关联表）
  userRoles UserRole[]

  @@map("roles")
}

// ==================== 用户与角色关联表（多对多） ====================
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==================== 法人公司表 ====================
model Company {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(20) // XACH / XACX / SCXH
  name      String    @db.VarChar(200)
  shortName String?   @map("short_name") @db.VarChar(50)
  city      String?   @db.VarChar(20) // 西安 / 四川
  address   String?   @db.VarChar(500)
  contact   String?   @db.VarChar(100)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系：一个 Company 有多个 Department
  departments Department[]

  // 关系：一个 Company 有多个 Employee
  employees Employee[]

  @@map("companies")
}

// ==================== 部门表 ====================
model Department {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(100)
  leaderId  String?   @map("leader_id") @db.Uuid // 关联 Employee.id，但暂不强制外键（避免循环依赖）
  order     Int       @default(0)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company      @relation(fields: [companyId], references: [id])
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  employees Employee[]

  @@index([companyId, parentId])
  @@map("departments")
}

// ==================== 员工表 ====================
model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  employeeNo     String    @unique @map("employee_no") @db.VarChar(20) // 工号：法人代码+年份+4位流水
  name           String    @db.VarChar(50)
  gender         String?   @db.VarChar(10) // male / female
  idCard         String?   @unique @map("id_card") @db.VarChar(255) // 加密存储（应用层处理）
  birthDate      DateTime? @map("birth_date") @db.Date
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(100)
  employmentType String    @map("employment_type") @db.VarChar(20) // formal / intern / consultant / labor
  status         String    @default("probation") @db.VarChar(20) // probation / active / resigned
  hireDate       DateTime? @map("hire_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User?       @relation(fields: [userId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([companyId, departmentId])
  @@index([employmentType, status])
  @@map("employees")
}

// ==================== 审计日志表（M0-08） ====================
// 只写不改不删：无 updatedAt / deletedAt，业务侧禁止更新与删除调用
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid // 操作用户 id，匿名/系统操作为 null（不建外键，用户删除不影响日志留存）
  // V1.2 新增：actor_type 区分操作主体（USER / AGENT / SYSTEM / INTEGRATION），为 AI Agent / 第三方对接审计铺垫
  actorType    String   @default("USER") @map("actor_type") @db.VarChar(20)
  action       String   @db.VarChar(50) // LOGIN / CREATE / UPDATE / DELETE / EXPORT / AUDIT_REVEAL
  resourceType String   @map("resource_type") @db.VarChar(50) // Auth / Employee / Salary / Attendance ...
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  description  String?  @db.Text // 人类可读描述
  oldValue     Json?    @map("old_value") // 变更前（敏感字段须在调用侧脱敏/省略）
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  status       String   @default("SUCCESS") @db.VarChar(20) // SUCCESS / FAILURE
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([actorType])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@index([resourceType, createdAt])
  @@index([actorType, createdAt])
  @@map("audit_logs")
}

// ==================== 审批流基础设施（M0.5-1）====================
// 三张表：模板（ApprovalFlow）→ 实例（ApprovalInstance）→ 节点操作记录（ApprovalRecord）
// 模板用 JSON 描述节点（含条件分支、审批人解析），实例挂任意业务对象

model ApprovalFlow {
  id          String   @id @default(uuid()) @db.Uuid
  category    String   @db.VarChar(50) // leave / onboarding / transfer / offboarding / overtime / performance / payslip ...
  key         String   @db.VarChar(100) // 同 category 内唯一（如 leave_default）
  name        String   @db.VarChar(200) // 模板显示名
  version     Int      @default(1) // 修订版本号（同 key 多次 update 自增）
  nodes       Json     // 节点数组：[{id, type, approverType, approverValue, condition, ...}]
  enabled     Boolean  @default(true)
  description String?  @db.Text
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除

  // 关系
  instances ApprovalInstance[]

  @@unique([category, key, version]) // 同一 (category, key) 不能重复 version
  @@index([category, key, enabled])
  @@index([enabled])
  @@map("approval_flows")
}

model ApprovalInstance {
  id             String   @id @default(uuid()) @db.Uuid
  flowId         String   @map("flow_id") @db.Uuid
  flowKey        String   @map("flow_key") @db.VarChar(100) // 冗余存储便于查询
  businessType   String   @map("business_type") @db.VarChar(50) // leave / onboarding / transfer ...
  businessId     String   @map("business_id") @db.Uuid // 关联业务记录 ID
  title          String   @db.VarChar(200)
  initiatorId    String   @map("initiator_id") @db.Uuid
  currentNodeId  String?  @map("current_node_id") @db.VarChar(64) // null 表示已完成
  status         String   @default("pending") @db.VarChar(20) // pending / approved / rejected / withdrawn
  data           Json     // 业务数据快照（用于条件分支判断，如请假天数）
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6) // status != pending 时填充

  // 关系
  flow    ApprovalFlow       @relation(fields: [flowId], references: [id], onDelete: Restrict)
  records ApprovalRecord[]

  @@index([flowKey])
  @@index([businessType, businessId])
  @@index([initiatorId, status])
  @@index([status])
  @@index([currentNodeId])
  @@map("approval_instances")
}

model ApprovalRecord {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String   @map("instance_id") @db.Uuid
  nodeId      String   @map("node_id") @db.VarChar(64)
  approverId  String   @map("approver_id") @db.Uuid
  action      String   @db.VarChar(20) // approve / reject / transfer / withdraw / auto_approve / auto_reject
  fromUserId  String?  @map("from_user_id") @db.Uuid // transfer 动作的转出方
  toUserId    String?  @map("to_user_id") @db.Uuid // transfer 动作的转入方
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([approverId, action])
  @@index([createdAt])
  @@map("approval_records")
}

// ==================== 通知（M0.5-2）====================
// 模板（NotificationTemplate）→ 日志（NotificationLog）
// 三种通道：in_app（站内信）/ email / sms
// 发送走 BullMQ 队列 + 失败重试 3 次

model NotificationTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @db.VarChar(100) // 全局唯一，如 contract_expiring / approval_pending
  name            String   @db.VarChar(200)
  channel         String   @db.VarChar(20) // in_app / email / sms
  subject         String?  @db.VarChar(200) // 邮件主题；短信/站内信可空
  contentTemplate String   @map("content_template") @db.Text // Handlebars 模板
  variables       Json?    // 变量定义（JSON schema），给前端/调用方参考
  enabled         Boolean  @default(true)
  description     String?  @db.Text
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系
  logs NotificationLog[]

  @@unique([key, channel]) // 同一 key 不同 channel 视为不同模板
  @@index([key, enabled])
  @@index([enabled])
  @@map("notification_templates")
}

model NotificationLog {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid // 模板删除后保留日志
  templateKey String?  @map("template_key") @db.VarChar(100) // 冗余存储便于查询
  userId      String   @map("user_id") @db.Uuid
  channel     String   @db.VarChar(20)
  status      String   @default("pending") @db.VarChar(20) // pending / sent / failed
  subject     String?  @db.VarChar(500)
  content     String   @db.Text // 渲染后内容
  data        Json?    // 渲染时使用的变量
  retryCount  Int      @default(0) @map("retry_count")
  lastError   String?  @map("last_error") @db.Text
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([userId, readAt]) // 查"未读"
  @@index([templateKey])
  @@index([channel, status])
  @@map("notification_logs")
}

// ==================== 字段加密（M0.5-3）====================
// 加密字段配置（EncryptedField）→ 访问审计（EncryptedFieldAudit）
// 算法：AES-256-GCM（认证加密），主密钥从 env 加载
// 存储格式：base64(iv).base64(ciphertext).base64(authTag)

model EncryptedField {
  id             String   @id @default(uuid()) @db.Uuid
  tableName      String   @map("table_name") @db.VarChar(100)
  columnName     String   @map("column_name") @db.VarChar(100)
  encryptionAlgo String   @default("aes-256-gcm") @map("encryption_algo") @db.VarChar(50)
  keyVersion     Int      @default(1) @map("key_version")
  accessRoles    Json     @map("access_roles") // ["admin", "hr", "self"]，self=员工本人
  enabled        Boolean  @default(true)
  description    String?  @db.Text
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系
  audits EncryptedFieldAudit[]

  @@unique([tableName, columnName])
  @@index([enabled])
  @@map("encrypted_fields")
}

model EncryptedFieldAudit {
  id        String   @id @default(uuid()) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  operation String   @db.VarChar(20) // encrypt / decrypt / rotate_key
  recordId  String?  @map("record_id") @db.Uuid // 哪条记录的字段被操作
  ipAddress String?  @map("ip_address") @db.VarChar(45) // IPv4/IPv6
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  field EncryptedField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, createdAt])
  @@index([userId, operation])
  @@index([createdAt])
  @@map("encrypted_field_audits")
}

// ==================== 第三方对接（M0.5-4）====================
// 集成配置（Integration）→ 同步日志（IntegrationSyncLog）
// 适配器类型：http_api / webhook / database / file
// config 字段存储敏感凭证（按 M0.5-3 加密规范走 AES-256-GCM）

model Integration {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @db.VarChar(50) // esign / sms / email / llm / ocr / map
  name        String   @db.VarChar(200)
  type        String   @db.VarChar(20) // http_api / webhook / database / file
  config      Json     // 配置（API Key / endpoint 等敏感字段）
  enabled     Boolean  @default(true)
  description String?  @db.Text
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系
  syncLogs IntegrationSyncLog[]

  @@unique([code])
  @@index([enabled])
  @@map("integrations")
}

model IntegrationSyncLog {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  status        String   @db.VarChar(20) // success / failed / partial
  operation     String   @db.VarChar(50) // send / sync / test_connection / pull
  recordCount   Int      @default(0) @map("record_count")
  duration      Int      @default(0) // 毫秒
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([status, createdAt])
  @@map("integration_sync_logs")
}
