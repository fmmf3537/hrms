// M0-04: Prisma schema 骨架 | HRMS | 2026-08-23
// 一期基础表：User / Role / UserRole / Company / Department / Employee

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户表 ====================
model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  email        String?   @unique @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  status       String    @default("active") @db.VarChar(20) // active / disabled
  // 首次登录/默认口令用户必须改密：seed 的 admin 置 true，改密成功后清 false
  mustChangePassword Boolean @default(false) @map("must_change_password")
  // 改密即全端下线：签发 JWT 时写入，校验时与 DB 对齐（可选增强）
  tokenVersion Int @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系：一个 User 对应一个 Employee
  employee Employee?

  // 关系：一个 User 拥有多个 Role（通过关联表）
  userRoles UserRole[]

  @@map("users")
}

// ==================== 角色表（RBAC） ====================
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50) // admin / hr / dept_head / executive / employee
  name        String   @db.VarChar(50) // 中文名
  description String?  @db.Text
  permissions Json     @default("[]") // 权限点数组
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系：一个 Role 被多个 User 拥有（通过关联表）
  userRoles UserRole[]

  @@map("roles")
}

// ==================== 用户与角色关联表（多对多） ====================
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==================== 法人公司表（M1-A1 扩展）====================
model Company {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(20) // XACH / XACX / SCXH
  name      String    @db.VarChar(200)
  shortName String?   @map("short_name") @db.VarChar(50)
  city      String?   @db.VarChar(20) // 西安 / 四川
  address   String?   @db.VarChar(500)
  contact   String?   @db.VarChar(100)
  status    String    @default("active") @db.VarChar(20) // active / suspended
  legalRep  String?   @map("legal_rep") @db.VarChar(50) // 法人代表
  taxNo     String?   @map("tax_no") @db.VarChar(50) // 税号
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  departments        Department[]
  employees          Employee[]
  onboardingRecords  OnboardingRecord[]

  @@index([status])
  @@map("companies")
}

// ==================== 部门表（M1-A1 扩展）====================
model Department {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid // 自引用，4 级层级上限（depth 0-3）
  code      String    @db.VarChar(50) // 部门编码（公司内唯一）
  name      String    @db.VarChar(200)
  leaderId  String?   @map("leader_id") @db.Uuid // 关联 Employee.id，暂不强制外键
  headcount Int       @default(0) // 编制数
  order     Int       @default(0)
  status    String    @default("active") @db.VarChar(20) // active / suspended / merged
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent            Department?        @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Department[]       @relation("DepartmentHierarchy")
  employees         Employee[]
  onboardingRecords OnboardingRecord[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([status])
  @@map("departments")
}

// ==================== 员工表（M1-A2 扩展）====================
// 敏感字段 idCard / bankCard / phone / emergencyContactPhone 走 crypto.service 加密
model Employee {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String? @unique @map("user_id") @db.Uuid // 1:1 关联 users（未建账号时为空）
  employeeNo  String  @unique @map("employee_no") @db.VarChar(30) // 工号
  name        String  @db.VarChar(50)
  // 基础信息
  gender          String?   @db.VarChar(10) // male / female
  birthDate       DateTime? @map("birth_date") @db.Date
  idCard          String?   @map("id_card") @db.Text // 加密存储
  nativePlace     String?   @map("native_place") @db.VarChar(200)
  ethnicity       String?   @db.VarChar(20)
  politicalStatus String?   @map("political_status") @db.VarChar(50)
  // 联系信息
  phone                 String? @map("phone") @db.Text // 加密
  email                 String? @db.VarChar(100)
  emergencyContactName  String? @map("emergency_contact_name") @db.VarChar(50)
  emergencyContactPhone String? @map("emergency_contact_phone") @db.Text // 加密
  address               String? @db.Text
  // 教育经历
  educationLevel String?   @map("education_level") @db.VarChar(50)
  degree         String?   @db.VarChar(50)
  school         String?   @db.VarChar(200)
  major          String?   @db.VarChar(100)
  graduationDate DateTime? @map("graduation_date") @db.Date
  // 工作经历 JSON
  workHistory Json? @map("work_history")
  // 合同（原 employment_type → contract_type）
  contractType  String?   @map("contract_type") @db.VarChar(50) // formal / intern / consultant / labor
  contractStart DateTime? @map("contract_start") @db.Date
  contractEnd   DateTime? @map("contract_end") @db.Date
  // 资质证书 JSON
  certificates Json?
  // 银行卡
  bankName String? @map("bank_name") @db.VarChar(100)
  bankCard String? @map("bank_card") @db.Text // 加密
  // 社保公积金
  socialInsured   Boolean  @default(false) @map("social_insured")
  socialCity      String?  @map("social_city") @db.VarChar(50)
  socialBase      Decimal? @map("social_base") @db.Decimal(10, 2)
  housingFundCity String?  @map("housing_fund_city") @db.VarChar(50)
  housingFundRate Decimal? @map("housing_fund_rate") @db.Decimal(4, 2)
  housingFundBase Decimal? @map("housing_fund_base") @db.Decimal(10, 2)
  // 公司 / 部门（departmentId 可选以保迁移安全；createEmployee 校验必填）
  companyId    String  @map("company_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  // 雇佣状态
  status          String    @default("probation") @db.VarChar(20) // probation / active / resigned
  hireDate        DateTime  @map("hire_date") @db.Date
  resignationDate DateTime? @map("resignation_date") @db.Date
  remark          String?   @db.Text
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User?       @relation(fields: [userId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([companyId, departmentId])
  @@index([status])
  @@index([contractEnd])
  @@index([hireDate])
  @@index([deletedAt])
  @@map("employees")
}

// ==================== 员工岗位历史（M1-A2 建表，A5 调动写入）====================
model EmployeePositionHistory {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  fromCompanyId String?  @map("from_company_id") @db.Uuid
  fromDeptId    String?  @map("from_dept_id") @db.Uuid
  fromPosition  String?  @map("from_position") @db.VarChar(100)
  toCompanyId   String   @map("to_company_id") @db.Uuid
  toDeptId      String   @map("to_dept_id") @db.Uuid
  toPosition    String   @map("to_position") @db.VarChar(100)
  changeType    String   @map("change_type") @db.VarChar(20) // promote / transfer / demote / hire
  changeDate    DateTime @map("change_date") @db.Date
  reason        String?  @db.Text
  operatorId    String?  @map("operator_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeId, changeDate])
  @@map("employee_position_history")
}

// ==================== 员工薪资历史（M1-A2 建表，A4 转正写入）====================
model EmployeeSalaryHistory {
  id                String   @id @default(uuid()) @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  effectiveDate     DateTime @map("effective_date") @db.Date
  baseSalary        Decimal  @map("base_salary") @db.Decimal(10, 2)
  performanceSalary Decimal? @map("performance_salary") @db.Decimal(10, 2)
  totalSalary       Decimal  @map("total_salary") @db.Decimal(10, 2)
  changeType        String   @map("change_type") @db.VarChar(20) // hire / promote / annual_adjust / performance
  reason            String?  @db.Text
  operatorId        String?  @map("operator_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeId, effectiveDate])
  @@map("employee_salary_history")
}

// ==================== 审计日志表（M0-08） ====================
// 只写不改不删：无 updatedAt / deletedAt，业务侧禁止更新与删除调用
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid // 操作用户 id，匿名/系统操作为 null（不建外键，用户删除不影响日志留存）
  // V1.2 新增：actor_type 区分操作主体（USER / AGENT / SYSTEM / INTEGRATION），为 AI Agent / 第三方对接审计铺垫
  actorType    String   @default("USER") @map("actor_type") @db.VarChar(20)
  action       String   @db.VarChar(50) // LOGIN / CREATE / UPDATE / DELETE / EXPORT / AUDIT_REVEAL
  resourceType String   @map("resource_type") @db.VarChar(50) // Auth / Employee / Salary / Attendance ...
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  description  String?  @db.Text // 人类可读描述
  oldValue     Json?    @map("old_value") // 变更前（敏感字段须在调用侧脱敏/省略）
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  status       String   @default("SUCCESS") @db.VarChar(20) // SUCCESS / FAILURE
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([actorType])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@index([resourceType, createdAt])
  @@index([actorType, createdAt])
  @@map("audit_logs")
}

// ==================== 审批流基础设施（M0.5-1）====================
// 三张表：模板（ApprovalFlow）→ 实例（ApprovalInstance）→ 节点操作记录（ApprovalRecord）
// 模板用 JSON 描述节点（含条件分支、审批人解析），实例挂任意业务对象

model ApprovalFlow {
  id          String   @id @default(uuid()) @db.Uuid
  category    String   @db.VarChar(50) // leave / onboarding / transfer / offboarding / overtime / performance / payslip ...
  key         String   @db.VarChar(100) // 同 category 内唯一（如 leave_default）
  name        String   @db.VarChar(200) // 模板显示名
  version     Int      @default(1) // 修订版本号（同 key 多次 update 自增）
  nodes       Json     // 节点数组：[{id, type, approverType, approverValue, condition, ...}]
  enabled     Boolean  @default(true)
  description String?  @db.Text
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删除

  // 关系
  instances ApprovalInstance[]

  @@unique([category, key, version]) // 同一 (category, key) 不能重复 version
  @@index([category, key, enabled])
  @@index([enabled])
  @@map("approval_flows")
}

model ApprovalInstance {
  id             String   @id @default(uuid()) @db.Uuid
  flowId         String   @map("flow_id") @db.Uuid
  flowKey        String   @map("flow_key") @db.VarChar(100) // 冗余存储便于查询
  businessType   String   @map("business_type") @db.VarChar(50) // leave / onboarding / transfer ...
  businessId     String   @map("business_id") @db.Uuid // 关联业务记录 ID
  title          String   @db.VarChar(200)
  initiatorId    String   @map("initiator_id") @db.Uuid
  currentNodeId  String?  @map("current_node_id") @db.VarChar(64) // null 表示已完成
  status         String   @default("pending") @db.VarChar(20) // pending / approved / rejected / withdrawn
  data           Json     // 业务数据快照（用于条件分支判断，如请假天数）
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6) // status != pending 时填充

  // 关系
  flow    ApprovalFlow       @relation(fields: [flowId], references: [id], onDelete: Restrict)
  records ApprovalRecord[]

  @@index([flowKey])
  @@index([businessType, businessId])
  @@index([initiatorId, status])
  @@index([status])
  @@index([currentNodeId])
  @@map("approval_instances")
}

model ApprovalRecord {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String   @map("instance_id") @db.Uuid
  nodeId      String   @map("node_id") @db.VarChar(64)
  approverId  String   @map("approver_id") @db.Uuid
  action      String   @db.VarChar(20) // approve / reject / transfer / withdraw / auto_approve / auto_reject
  fromUserId  String?  @map("from_user_id") @db.Uuid // transfer 动作的转出方
  toUserId    String?  @map("to_user_id") @db.Uuid // transfer 动作的转入方
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([approverId, action])
  @@index([createdAt])
  @@map("approval_records")
}

// ==================== 通知（M0.5-2）====================
// 模板（NotificationTemplate）→ 日志（NotificationLog）
// 三种通道：in_app（站内信）/ email / sms
// 发送走 BullMQ 队列 + 失败重试 3 次

model NotificationTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @db.VarChar(100) // 全局唯一，如 contract_expiring / approval_pending
  name            String   @db.VarChar(200)
  channel         String   @db.VarChar(20) // in_app / email / sms
  subject         String?  @db.VarChar(200) // 邮件主题；短信/站内信可空
  contentTemplate String   @map("content_template") @db.Text // Handlebars 模板
  variables       Json?    // 变量定义（JSON schema），给前端/调用方参考
  enabled         Boolean  @default(true)
  description     String?  @db.Text
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系
  logs NotificationLog[]

  @@unique([key, channel]) // 同一 key 不同 channel 视为不同模板
  @@index([key, enabled])
  @@index([enabled])
  @@map("notification_templates")
}

model NotificationLog {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid // 模板删除后保留日志
  templateKey String?  @map("template_key") @db.VarChar(100) // 冗余存储便于查询
  userId      String   @map("user_id") @db.Uuid
  channel     String   @db.VarChar(20)
  status      String   @default("pending") @db.VarChar(20) // pending / sent / failed
  subject     String?  @db.VarChar(500)
  content     String   @db.Text // 渲染后内容
  data        Json?    // 渲染时使用的变量
  retryCount  Int      @default(0) @map("retry_count")
  lastError   String?  @map("last_error") @db.Text
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([userId, readAt]) // 查"未读"
  @@index([templateKey])
  @@index([channel, status])
  @@map("notification_logs")
}

// ==================== 字段加密（M0.5-3）====================
// 加密字段配置（EncryptedField）→ 访问审计（EncryptedFieldAudit）
// 算法：AES-256-GCM（认证加密），主密钥从 env 加载
// 存储格式：base64(iv).base64(ciphertext).base64(authTag)

model EncryptedField {
  id             String   @id @default(uuid()) @db.Uuid
  tableName      String   @map("table_name") @db.VarChar(100)
  columnName     String   @map("column_name") @db.VarChar(100)
  encryptionAlgo String   @default("aes-256-gcm") @map("encryption_algo") @db.VarChar(50)
  keyVersion     Int      @default(1) @map("key_version")
  accessRoles    Json     @map("access_roles") // ["admin", "hr", "self"]，self=员工本人
  enabled        Boolean  @default(true)
  description    String?  @db.Text
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系
  audits EncryptedFieldAudit[]

  @@unique([tableName, columnName])
  @@index([enabled])
  @@map("encrypted_fields")
}

model EncryptedFieldAudit {
  id        String   @id @default(uuid()) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  operation String   @db.VarChar(20) // encrypt / decrypt / rotate_key
  recordId  String?  @map("record_id") @db.Uuid // 哪条记录的字段被操作
  ipAddress String?  @map("ip_address") @db.VarChar(45) // IPv4/IPv6
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  field EncryptedField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, createdAt])
  @@index([userId, operation])
  @@index([createdAt])
  @@map("encrypted_field_audits")
}

// ==================== 第三方对接（M0.5-4）====================
// 集成配置（Integration）→ 同步日志（IntegrationSyncLog）
// 适配器类型：http_api / webhook / database / file
// config 字段存储敏感凭证（按 M0.5-3 加密规范走 AES-256-GCM）

model Integration {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @db.VarChar(50) // esign / sms / email / llm / ocr / map
  name        String   @db.VarChar(200)
  type        String   @db.VarChar(20) // http_api / webhook / database / file
  config      Json     // 配置（API Key / endpoint 等敏感字段）
  enabled     Boolean  @default(true)
  description String?  @db.Text
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系
  syncLogs IntegrationSyncLog[]

  @@unique([code])
  @@index([enabled])
  @@map("integrations")
}

model IntegrationSyncLog {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  status        String   @db.VarChar(20) // success / failed / partial
  operation     String   @db.VarChar(50) // send / sync / test_connection / pull
  recordCount   Int      @default(0) @map("record_count")
  duration      Int      @default(0) // 毫秒
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 关系
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([status, createdAt])
  @@map("integration_sync_logs")
}

// ==================== 配置中心（M0.5-6）====================
// 业务规则统一走 configs + effective_from / effective_to 版本回溯（V1.2 §三.5）

model Config {
  id            String    @id @default(uuid()) @db.Uuid
  category      String    @db.VarChar(50)
  key           String    @db.VarChar(100)
  value         Json
  version       Int       @default(1)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  remark        String?   @db.Text

  @@unique([category, key, version])
  @@index([category, key, effectiveFrom])
  @@index([effectiveTo])
  @@map("configs")
}

// ==================== AI 底座（M0.5-5）====================
// ai_documents（知识库文档）+ ai_embeddings（pgvector 向量）
// ai_conversations（对话历史）+ ai_summaries（AI 生成摘要缓存）

model AiDocument {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(500)
  sourceType  String    @map("source_type") @db.VarChar(50) // employee_handbook / faq / policy / procedure
  content     String    @db.Text // 完整原文
  metadata    Json? // 来源 URL / 版本号 / 维护人 等
  enabled     Boolean   @default(true)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  embeddings AiEmbedding[]

  @@index([sourceType, enabled])
  @@index([createdAt])
  @@map("ai_documents")
}

model AiEmbedding {
  id         String                       @id @default(uuid()) @db.Uuid
  documentId String                       @map("document_id") @db.Uuid
  chunkIndex Int                          @map("chunk_index") // 文档分块后的顺序
  chunkText  String                       @map("chunk_text") @db.Text
  embedding  Unsupported("vector(1536)")? // pgvector 维度（OpenAI text-embedding-3-small 1536 维）
  tokenCount Int?                         @map("token_count")
  createdAt  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@map("ai_embeddings")
}

model AiConversation {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  documentId String?  @map("document_id") @db.Uuid // 命中的知识库文档（可空：闲聊）
  question   String   @db.Text
  answer     String   @db.Text
  sources    Json? // 来源文档列表 [{title, score}]
  tokens     Int      @default(0)
  cost       Decimal  @default(0) @db.Decimal(10, 6) // USD 元
  duration   Int      @default(0) // 毫秒
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_conversations")
}

model AiSummary {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(50) // payroll_diff / performance_summary / contract_renewal
  referenceId String?   @map("reference_id") @db.Uuid // 关联业务记录 ID（工资单/绩效/合同）
  content     String    @db.Text
  highlights  Json? // 高亮要点
  tokens      Int       @default(0)
  cost        Decimal   @default(0) @db.Decimal(10, 6)
  duration    Int       @default(0)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6) // 缓存过期
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([type, referenceId])
  @@index([expiresAt])
  @@map("ai_summaries")
}

// ==================== M1-A3 入职流程 ====================
// 状态机：draft → submitted → approved / cancelled
// 关联 employee 后字段被复制到 employees 表
model OnboardingRecord {
  id           String    @id @default(uuid()) @db.Uuid
  // 草稿基本信息
  name         String    @db.VarChar(50)
  gender       String?   @db.VarChar(10)
  birthDate    DateTime? @map("birth_date") @db.Date
  phone        String?   @map("phone") @db.Text // 加密
  email        String?   @db.VarChar(100)
  // 入职单位 / 部门（草稿阶段允许先选好）
  companyId    String    @map("company_id") @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  // 入职信息
  hireDate     DateTime  @map("hire_date") @db.Date
  contractType String    @map("contract_type") @db.VarChar(50)
  // 试用期
  probationMonths Int? @map("probation_months") // 默认从 configs.probation.months 读
  // 薪资（草稿可填，正式入 employee 表时再写 history）
  baseSalary Decimal? @map("base_salary") @db.Decimal(10, 2)
  // OCR 临时字段（草稿阶段保存，confirm 时复制到 employees 表）
  idCard        String?   @map("id_card") @db.Text // 加密
  idCardOcrAt   DateTime? @map("id_card_ocr_at") @db.Timestamptz(6)
  bankName      String?   @map("bank_name") @db.VarChar(100)
  bankCard      String?   @map("bank_card") @db.Text // 加密
  bankCardOcrAt DateTime? @map("bank_card_ocr_at") @db.Timestamptz(6)
  certificates  Json? // [{name, number, issueDate, expireDate, imageUrl}]
  // 材料完整性（走 configs.onboarding.required_materials 校验）
  materialsChecklist Json? @map("materials_checklist")
  // 状态机 draft / submitted / approved / cancelled
  status String @default("draft") @db.VarChar(20)
  // 审批流（M0.5-1）
  approvalInstanceId String? @unique @map("approval_instance_id") @db.Uuid
  // 关联 employee（approved 后回填）
  employeeId String? @unique @map("employee_id") @db.Uuid
  // 元数据
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledReason String?   @map("cancelled_reason") @db.Text

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  tasks      OnboardingTask[]

  @@index([companyId, status])
  @@index([status, hireDate])
  @@index([createdBy, status])
  @@map("onboarding_records")
}

// 入职引导清单（configs.onboarding.checklist 模板 → 实际任务实例）
model OnboardingTask {
  id           String    @id @default(uuid()) @db.Uuid
  onboardingId String    @map("onboarding_id") @db.Uuid
  // 任务名（来自 checklist 模板）
  name         String    @db.VarChar(100) // '设备发放' / '工位安排' / '导师分配' / '培训安排'
  // 任务类别 equipment / workspace / mentor / training
  category     String    @db.VarChar(50)
  // 负责人
  ownerId      String?   @map("owner_id") @db.Uuid
  // 状态 pending / in_progress / done / skipped
  status       String    @default("pending") @db.VarChar(20)
  dueDate      DateTime? @map("due_date") @db.Date
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy  String?   @map("completed_by") @db.Uuid
  remark       String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  onboarding OnboardingRecord @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId, status])
  @@index([ownerId, status])
  @@map("onboarding_tasks")
}

// ==================== M1-A4 转正流程 ====================
// 状态机：draft → submitted → approved / rejected / cancelled
// 不建 Employee 反向关系（避免改 A1+A2 已有 model）；service 层校验 active 唯一
model RegularizationRecord {
  id               String   @id @default(uuid()) @db.Uuid
  // 关联员工（必须是 probation 状态；无 Prisma relation，避免改 Employee）
  employeeId       String   @map("employee_id") @db.Uuid
  // 试用期
  hireDate         DateTime @map("hire_date") @db.Date
  probationEndDate DateTime @map("probation_end_date") @db.Date
  // 申请内容
  appliedAt           DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  selfEvaluation      String?  @map("self_evaluation") @db.Text
  managerEvaluation   String?  @map("manager_evaluation") @db.Text
  hrEvaluation        String?  @map("hr_evaluation") @db.Text
  performanceScore    Int?     @map("performance_score")
  // 转正后薪资（如有调整）
  newBaseSalary         Decimal? @map("new_base_salary") @db.Decimal(10, 2)
  newPerformanceSalary  Decimal? @map("new_performance_salary") @db.Decimal(10, 2)
  newTotalSalary        Decimal? @map("new_total_salary") @db.Decimal(10, 2)
  // 状态机 draft / submitted / approved / rejected / cancelled
  status String @default("draft") @db.VarChar(20)
  // 审批流（M0.5-1）
  approvalInstanceId String? @unique @map("approval_instance_id") @db.Uuid
  // 审批结果
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy     String?   @map("approved_by") @db.Uuid
  rejectedAt     DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy     String?   @map("rejected_by") @db.Uuid
  rejectedReason String?   @map("rejected_reason") @db.Text
  // 元数据
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelledReason String?   @map("cancelled_reason") @db.Text

  @@index([employeeId, status])
  @@index([status, probationEndDate])
  @@map("regularization_records")
}
