// M0-04: Prisma schema 骨架 | HRMS | 2026-08-23
// 一期基础表：User / Role / UserRole / Company / Department / Employee

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户表 ====================
model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  email        String?   @unique @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  status       String    @default("active") @db.VarChar(20) // active / disabled
  // 首次登录/默认口令用户必须改密：seed 的 admin 置 true，改密接口（M1）成功后清 false
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系：一个 User 对应一个 Employee
  employee Employee?

  // 关系：一个 User 拥有多个 Role（通过关联表）
  userRoles UserRole[]

  @@map("users")
}

// ==================== 角色表（RBAC） ====================
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50) // admin / hr / dept_head / executive / employee
  name        String   @db.VarChar(50) // 中文名
  description String?  @db.Text
  permissions Json     @default("[]") // 权限点数组
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系：一个 Role 被多个 User 拥有（通过关联表）
  userRoles UserRole[]

  @@map("roles")
}

// ==================== 用户与角色关联表（多对多） ====================
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==================== 法人公司表 ====================
model Company {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(20) // XACH / XACX / SCXH
  name      String    @db.VarChar(200)
  shortName String?   @map("short_name") @db.VarChar(50)
  city      String?   @db.VarChar(20) // 西安 / 四川
  address   String?   @db.VarChar(500)
  contact   String?   @db.VarChar(100)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // 关系：一个 Company 有多个 Department
  departments Department[]

  // 关系：一个 Company 有多个 Employee
  employees Employee[]

  @@map("companies")
}

// ==================== 部门表 ====================
model Department {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(100)
  leaderId  String?   @map("leader_id") @db.Uuid // 关联 Employee.id，但暂不强制外键（避免循环依赖）
  order     Int       @default(0)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company      @relation(fields: [companyId], references: [id])
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  employees Employee[]

  @@index([companyId, parentId])
  @@map("departments")
}

// ==================== 员工表 ====================
model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  employeeNo     String    @unique @map("employee_no") @db.VarChar(20) // 工号：法人代码+年份+4位流水
  name           String    @db.VarChar(50)
  gender         String?   @db.VarChar(10) // male / female
  idCard         String?   @unique @map("id_card") @db.VarChar(255) // 加密存储（应用层处理）
  birthDate      DateTime? @map("birth_date") @db.Date
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(100)
  employmentType String    @map("employment_type") @db.VarChar(20) // formal / intern / consultant / labor
  status         String    @default("probation") @db.VarChar(20) // probation / active / resigned
  hireDate       DateTime? @map("hire_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User?       @relation(fields: [userId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([companyId, departmentId])
  @@index([employmentType, status])
  @@map("employees")
}

// ==================== 审计日志表（M0-08） ====================
// 只写不改不删：无 updatedAt / deletedAt，业务侧禁止更新与删除调用
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid // 操作用户 id，匿名/系统操作为 null（不建外键，用户删除不影响日志留存）
  action       String   @db.VarChar(50) // LOGIN / CREATE / UPDATE / DELETE / EXPORT
  resourceType String   @map("resource_type") @db.VarChar(50) // Auth / Employee / Salary / Attendance ...
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  description  String?  @db.Text // 人类可读描述
  oldValue     Json?    @map("old_value") // 变更前（敏感字段须在调用侧脱敏/省略）
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  status       String   @default("SUCCESS") @db.VarChar(20) // SUCCESS / FAILURE
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@index([resourceType, createdAt])
  @@map("audit_logs")
}
