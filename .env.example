# ===== 数据库 =====
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=hrms
DB_PORT=5501

# ===== Redis =====
REDIS_PORT=6401
REDIS_URL=redis://localhost:6401

# ===== Prisma =====
DATABASE_URL=postgresql://postgres:changeme@localhost:5501/hrms?schema=public

# ===== JWT =====
JWT_SECRET=dev-only-jwt-secret-min-32-chars-change-in-prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-min-32-chars-change-in-prod
JWT_REFRESH_EXPIRES_IN=7d

# ===== Server =====
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ===== Client =====
VITE_API_BASE_URL=http://localhost:3000/api
